---
import { site } from '../data/site';
import type { ArticleEntity, ProjectEntity } from '../data/site';

interface Props {
  /** Page title without the site name; the site name is appended automatically. */
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  /** Structured-data entity, only for pages that describe a project. */
  project?: ProjectEntity;
  /** Structured-data facts for an engineering article page. */
  article?: ArticleEntity;
  /** Marks the page as a schema.org ProfilePage whose mainEntity is the Person. */
  profilePage?: boolean;
}

const { title, description = site.description, type = 'website', project, article, profilePage } = Astro.props;

const pageTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.role}`;

// Canonical and Open Graph URLs are only emitted once the production domain is
// configured (see src/data/site.ts), so no URL is ever invented.
const canonicalUrl = site.url ? new URL(Astro.url.pathname, site.url).href : '';

// Canonical origin written with the trailing slash the site's own URLs use, so
// every `url` in the structured data matches the canonical URL exactly.
const siteUrl = `${site.url.replace(/\/+$/, '')}/`;

/**
 * Structured data for the person behind the site. Both entities use a stable
 * `@id` built from the canonical origin, so later phases can reference the same
 * nodes instead of redefining them. `Person.name` is the full name,
 * `alternateName` lists the verified spellings the site and the public profiles
 * use, and `knowsAbout` repeats only the topics /about already publishes.
 */
const personId = `${siteUrl}#person`;

/**
 * Project pages add their own entity, plus a `SoftwareSourceCode` node when the
 * project has a public repository: `codeRepository` is only valid on
 * `SoftwareSourceCode`, so the repository is expressed as a linked node instead
 * of an invented property on the application. Both nodes reuse the canonical URL
 * of the page and reference the `Person` above by `@id`.
 */
const projectNodes =
  project && canonicalUrl
    ? [
        {
          '@type': project.type,
          '@id': `${canonicalUrl}#project`,
          name: project.name,
          description: project.description,
          url: canonicalUrl,
          author: { '@id': personId },
          ...(project.installUrl ? { installUrl: project.installUrl } : {}),
        },
        ...(project.codeRepository
          ? [
              {
                '@type': 'SoftwareSourceCode',
                '@id': `${canonicalUrl}#source`,
                // Repository name taken from the repository URL itself, so the
                // node has a `name` without inventing one.
                name: project.codeRepository.replace(/\/+$/, '').split('/').pop() ?? project.name,
                codeRepository: project.codeRepository,
                author: { '@id': personId },
                targetProduct: { '@id': `${canonicalUrl}#project` },
              },
            ]
          : []),
      ]
    : [];

/**
 * Engineering article pages add a single `TechArticle` node. It reuses the
 * canonical URL of the page as its `@id` and references the shared `Person`
 * and `WebSite` nodes by `@id`, so the identity entities are never redefined.
 */
const articleNode =
  article && canonicalUrl
    ? {
        '@type': 'TechArticle',
        '@id': `${canonicalUrl}#article`,
        headline: article.title,
        description: article.description,
        datePublished: article.pubDate,
        url: canonicalUrl,
        inLanguage: article.lang,
        author: { '@id': personId },
        isPartOf: { '@id': `${siteUrl}#website` },
      }
    : null;

/**
 * The About page adds a `ProfilePage` node. It does not redefine the person:
 * `mainEntity` references the shared `Person` by `@id`, so there is still
 * exactly one `Person` node for the whole site.
 */
const profilePageNode =
  profilePage && canonicalUrl
    ? {
        '@type': 'ProfilePage',
        '@id': `${canonicalUrl.replace(/[/]$/, '')}/#profile`,
        url: canonicalUrl,
        mainEntity: { '@id': personId },
      }
    : null;

const identityJson = site.url
  ? JSON.stringify({
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'Person',
          '@id': personId,
          name: site.identity.fullName,
          // Verified spellings only: the professional name the site displays
          // plus the ones the public profiles themselves use.
          alternateName: [site.name, ...site.identity.alternateNames],
          url: siteUrl,
          jobTitle: site.role,
          description: site.description,
          sameAs: [site.identity.github, site.identity.linkedin],
          knowsAbout: site.identity.knowsAbout,
        },
        {
          '@type': 'WebSite',
          '@id': `${siteUrl}#website`,
          name: site.name,
          url: siteUrl,
          description: site.description,
          inLanguage: site.locale,
          creator: { '@id': personId },
        },
        ...(profilePageNode ? [profilePageNode] : []),
        ...projectNodes,
        ...(articleNode ? [articleNode] : []),
      ],
    })
      // `<` is escaped so the JSON can never close the surrounding script tag.
      .replace(/</g, '\\u003c')
  : '';
---

<title>{pageTitle}</title>
<meta name="description" content={description} />
<meta name="theme-color" content={site.themeColor} />
{canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
<meta property="og:type" content={type} />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
{canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
<meta name="twitter:card" content="summary" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
{identityJson && <script type="application/ld+json" is:inline set:html={identityJson} />}
