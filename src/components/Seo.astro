---
import { site } from '../data/site';

interface Props {
  /** Page title without the site name; the site name is appended automatically. */
  title?: string;
  description?: string;
  type?: 'website' | 'article';
}

const { title, description = site.description, type = 'website' } = Astro.props;

const pageTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.role}`;

// Canonical and Open Graph URLs are only emitted once the production domain is
// configured (see src/data/site.ts), so no URL is ever invented.
const canonicalUrl = site.url ? new URL(Astro.url.pathname, site.url).href : '';
---

<title>{pageTitle}</title>
<meta name="description" content={description} />
<meta name="theme-color" content={site.themeColor} />
{canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
<meta property="og:type" content={type} />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
{canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
<meta name="twitter:card" content="summary" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
