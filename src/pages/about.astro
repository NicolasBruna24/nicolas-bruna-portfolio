---
import ScrollCue from '../components/ScrollCue.astro';
import { about } from '../data/about';
import BaseLayout from '../layouts/BaseLayout.astro';

const { hero, seo } = about;
---

<BaseLayout title={seo.title} description={seo.description} type="website">
  <section class="hero">
    <div class="container hero__inner">
      <div class="hero__content">
        <p class="eyebrow" data-reveal>About</p>
        <h1 class="hero__title" data-reveal data-reveal-delay="1">{hero.heading}</h1>
        <p class="hero__name" data-reveal data-reveal-delay="2">
          {hero.name} <span aria-hidden="true">—</span> {hero.role}
        </p>
        <p class="hero__intro" data-reveal data-reveal-delay="3">{hero.intro}</p>
        <ul class="hero__meta" data-reveal data-reveal-delay="4" aria-label="Location and working languages">
          {hero.meta.map((item) => <li class="chip">{item}</li>)}
        </ul>
      </div>

      <ScrollCue targetId="about" hint="to the about section" />
    </div>
  </section>

  <section class="section" id="about" aria-labelledby="about-title">
    <div class="container">
      <header class="section__header" data-reveal>
        <p class="eyebrow" aria-hidden="true">01</p>
        <h2 class="section__title" id="about-title">{about.about.heading}</h2>
      </header>

      <div class="prose" data-reveal>
        {about.about.body.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>
  </section>

  <section class="section" id="how-i-work" aria-labelledby="work-title">
    <div class="container">
      <header class="section__header" data-reveal>
        <p class="eyebrow" aria-hidden="true">02</p>
        <h2 class="section__title" id="work-title">{about.principles.heading}</h2>
        <p class="section__lead">{about.principles.lead}</p>
      </header>

      <ol class="cards">
        {
          about.principles.items.map((item, index) => (
            <li class="cards__item" data-reveal>
              <p class="cards__index" aria-hidden="true">0{index + 1}</p>
              <h3 class="cards__title">{item.title}</h3>
              <p class="cards__text">{item.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section" id="what-i-build" aria-labelledby="areas-title">
    <div class="container">
      <header class="section__header" data-reveal>
        <p class="eyebrow" aria-hidden="true">03</p>
        <h2 class="section__title" id="areas-title">{about.areas.heading}</h2>
        <p class="section__lead">{about.areas.lead}</p>
      </header>

      <dl class="rows">
        {
          about.areas.items.map((area) => (
            <div class="rows__item" data-reveal>
              <dt class="rows__term">{area.title}</dt>
              <dd class="rows__detail">{area.body}</dd>
            </div>
          ))
        }
      </dl>

      <p class="note" data-reveal>{about.areas.note}</p>
    </div>
  </section>

  <section class="section" id="projects" aria-labelledby="projects-title">
    <div class="container">
      <header class="section__header" data-reveal>
        <p class="eyebrow" aria-hidden="true">04</p>
        <h2 class="section__title" id="projects-title">{about.projects.heading}</h2>
        <p class="section__lead">{about.projects.lead}</p>
      </header>

      <ul class="projects">
        {
          about.projects.items.map((project) => (
            <li class="projects__item" data-reveal>
              <a class="projects__link" href={project.route}>
                <span class="projects__name">
                  {project.name}
                  {project.status && (
                    <span class="chip projects__status">
                      {project.status}
                      <span class="u-visually-hidden"> — project status</span>
                    </span>
                  )}
                </span>
                <span class="projects__summary">{project.summary}</span>
                <span class="projects__blurb">{project.blurb}</span>
                <span class="projects__cta" aria-hidden="true">
                  Read the case study <span>→</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>

      <p class="note" data-reveal>{about.projects.note}</p>
    </div>
  </section>
  <section class="section" id="focus" aria-labelledby="focus-title">
    <div class="container">
      <header class="section__header" data-reveal>
        <p class="eyebrow" aria-hidden="true">05</p>
        <h2 class="section__title" id="focus-title">{about.focus.heading}</h2>
        <p class="section__lead">{about.focus.lead}</p>
      </header>

      <ul class="chips" data-reveal>
        {about.focus.items.map((item) => <li class="chip">{item}</li>)}
      </ul>
    </div>
  </section>

  <section class="section" id="philosophy" aria-labelledby="philosophy-title">
    <div class="container">
      <header class="section__header" data-reveal>
        <p class="eyebrow" aria-hidden="true">06</p>
        <h2 class="section__title" id="philosophy-title">{about.philosophy.heading}</h2>
        <p class="section__lead">{about.philosophy.statement}</p>
      </header>

      <div class="prose" data-reveal>
        {about.philosophy.body.map((paragraph) => <p>{paragraph}</p>)}
      </div>

      <blockquote class="quote" data-reveal>
        <p>{about.philosophy.quote}</p>
      </blockquote>
    </div>
  </section>

  <section class="section" id="education" aria-labelledby="education-title">
    <div class="container">
      <header class="section__header" data-reveal>
        <p class="eyebrow" aria-hidden="true">07</p>
        <h2 class="section__title" id="education-title">{about.education.heading}</h2>
      </header>

      <dl class="rows rows--compact">
        {
          about.education.items.map((entry) => (
            <div class="rows__item" data-reveal>
              <dt class="rows__term">{entry.title}</dt>
              <dd class="rows__detail">{entry.detail}</dd>
            </div>
          ))
        }
      </dl>

      <p class="note" data-reveal>{about.education.note}</p>
    </div>
  </section>

  <section class="section" id="technologies" aria-labelledby="tech-title">
    <div class="container">
      <header class="section__header" data-reveal>
        <p class="eyebrow" aria-hidden="true">08</p>
        <h2 class="section__title" id="tech-title">{about.technologies.heading}</h2>
        <p class="section__lead">{about.technologies.lead}</p>
      </header>

      <dl class="rows">
        {
          about.technologies.groups.map((group) => (
            <div class="rows__item" data-reveal>
              <dt class="rows__term rows__term--mono">{group.label}</dt>
              <dd class="rows__detail">
                <ul class="chips chips--tight" aria-label={group.label}>
                  {group.items.map((item) => <li class="chip">{item}</li>)}
                </ul>
                {group.note && <p class="rows__note">{group.note}</p>}
              </dd>
            </div>
          ))
        }
      </dl>

      <p class="note" data-reveal>{about.technologies.note}</p>
    </div>
  </section>

  <section class="section" id="direction" aria-labelledby="direction-title">
    <div class="container">
      <header class="section__header" data-reveal>
        <p class="eyebrow" aria-hidden="true">09</p>
        <h2 class="section__title" id="direction-title">{about.direction.heading}</h2>
      </header>

      <div class="prose" data-reveal>
        {about.direction.body.map((paragraph) => <p>{paragraph}</p>)}
      </div>

      <ul class="chips" data-reveal>
        {about.direction.interests.map((interest) => <li class="chip">{interest}</li>)}
      </ul>
    </div>
  </section>

  <section class="closing" id="cta" aria-labelledby="closing-title">
    <div class="container">
      <h2 class="closing__title" id="closing-title" data-reveal>{about.closing.heading}</h2>
      <p class="closing__body" data-reveal>{about.closing.body}</p>

      <div class="closing__actions" data-reveal>
        {about.closing.links.map((link, index) => (
          <a class={index === 0 ? 'btn btn--primary' : 'btn btn--ghost'} href={link.href}>
            {link.label}
          </a>
        ))}
      </div>
    </div>
  </section>
<style>
  /* Page-local layout. Type, buttons, chips, sections and eyebrows come from
     the global layer; editorial patterns mirror the case-study pages. */

  .hero {
    display: grid;
    min-height: 100vh;
    min-height: 100svh;
  }

  .hero__inner {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: var(--space-8);
    padding-block: calc(var(--nav-height) + var(--space-8)) var(--space-7);
  }

  .hero__content {
    display: grid;
    gap: var(--space-4);
  }

  .hero__title {
    max-width: 16ch;
    font-size: clamp(2.25rem, 1.2rem + 5.5vw, 4.75rem);
    line-height: var(--leading-tight);
    text-wrap: balance;
  }

  .hero__name {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }

  .hero__intro {
    max-width: var(--measure);
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
  }

  .hero__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .prose {
    display: grid;
    gap: var(--space-4);
  }

  .prose p {
    max-width: var(--measure);
    color: var(--color-text-secondary);
  }

  .note {
    max-width: var(--measure);
    margin-block-start: var(--space-6);
    padding-inline-start: var(--space-5);
    border-inline-start: 1px solid var(--color-border);
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }

  .quote {
    max-width: var(--measure);
    margin-block-start: var(--space-8);
    padding-inline-start: var(--space-6);
    border-inline-start: 2px solid var(--color-accent);
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 600;
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-snug);
    text-wrap: balance;
  }

  .cards {
    display: grid;
    gap: var(--space-6);
  }

  .cards__item {
    display: grid;
    gap: var(--space-2);
    align-content: start;
    padding-block-start: var(--space-5);
    border-block-start: 1px solid var(--color-border);
  }

  .cards__index {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    color: var(--color-text-secondary);
  }

  .cards__title {
    font-size: var(--text-xl);
  }

  .cards__text {
    max-width: var(--measure);
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }

  .rows {
    display: grid;
    gap: var(--space-6);
  }

  .rows__item {
    display: grid;
    gap: var(--space-2);
  }

  .rows__item:not(:first-child) {
    border-block-start: 1px solid var(--color-border);
    padding-block-start: var(--space-6);
  }

  .rows__term {
    font-family: var(--font-display);
    font-size: var(--text-md);
    font-weight: 600;
    letter-spacing: var(--tracking-tight);
  }

  .rows__term--mono {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 400;
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }

  .rows__detail {
    max-width: var(--measure);
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }

  .rows__note {
    margin-block-start: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
  }

  .rows--compact {
    max-width: 40rem;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-block-start: var(--space-6);
    max-width: 52rem;
  }

  .chips--tight {
    margin-block-start: 0;
  }

  .projects {
    display: grid;
    gap: var(--space-2);
  }

  .projects__item:not(:first-child) {
    border-block-start: 1px solid var(--color-border);
    padding-block-start: var(--space-2);
  }

  .projects__link {
    display: grid;
    gap: var(--space-2);
    padding-block: var(--space-4);
    border-radius: var(--radius-sm);
    transition: transform var(--duration-base) var(--ease-out);
  }

  .projects__link:hover {
    transform: translateY(-2px);
  }

  .projects__name {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 600;
    letter-spacing: var(--tracking-tight);
  }

  .projects__link:hover .projects__name {
    color: var(--color-accent);
  }

  .projects__summary {
    max-width: var(--measure);
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }

  .projects__blurb {
    max-width: var(--measure);
    font-size: var(--text-sm);
    color: var(--color-text);
  }

  .projects__cta {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }

  .projects__link:hover .projects__cta {
    color: var(--color-text);
  }

  .closing {
    padding-block: var(--section-space);
    border-block-start: 1px solid var(--color-border);
  }

  .closing__title {
    max-width: 24ch;
    font-size: var(--text-2xl);
    text-wrap: balance;
  }

  .closing__body {
    max-width: var(--measure);
    margin-block-start: var(--space-5);
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
  }

  .closing__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-block-start: var(--space-6);
  }

  @media (min-width: 48rem) {
    .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-6) var(--space-8);
    }

    .rows__item {
      grid-template-columns: minmax(0, 12rem) minmax(0, 1fr);
      gap: var(--space-6);
      align-items: baseline;
    }
  }

  @media (min-width: 64rem) {
    .cards {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
</BaseLayout>
