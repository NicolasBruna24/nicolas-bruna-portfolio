---
import type { MarkdownInstance } from 'astro';
import { about } from '../../data/about';
import { engineeringArticles } from '../../data/engineering';
import { site } from '../../data/site';
import BaseLayout from '../../layouts/BaseLayout.astro';

export function getStaticPaths() {
  return engineeringArticles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

/**
 * Markdown bodies live in `src/content/engineering/<slug>.md`; the typed
 * metadata (title, description, dates, tags) lives in `src/data/engineering.ts`.
 * Astro compiles `.md` imports natively — no content collections or MDX needed.
 */
const modules = import.meta.glob('/src/content/engineering/*.md', {
  eager: true,
}) as Record<string, MarkdownInstance<Record<string, string>>>;

const { article } = Astro.props;
const module = Object.entries(modules).find(
  ([path]) => (path.split('/').pop() ?? '').replace(/\.md$/, '') === article.slug,
);

if (!module) {
  throw new Error(
    `Engineering article "/engineering/${article.slug}" has no Markdown body in src/content/engineering/.`,
  );
}

const { Content } = module[1];

/**
 * `pubDate` is a content date (`YYYY-MM-DD`) with no time and no timezone, and
 * `new Date('2026-09-21')` parses it as UTC midnight. Formatting in UTC keeps
 * the rendered date equal to the declared one no matter which timezone the
 * build runs in (locally in UTC-3/-4 it used to slip to the previous day).
 */
const dateFormatter = new Intl.DateTimeFormat('en-CA', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
---

<BaseLayout
  title={article.title}
  description={article.description}
  type="article"
  lang={article.lang}
  article={{
    title: article.title,
    description: article.description,
    pubDate: article.pubDate,
    lang: article.lang,
  }}
>
  <article class="section" id="article" aria-labelledby="article-title">
    <div class="container">
      <header class="article-header" data-reveal>
        {/* Chrome labels stay in the site language; the article body does not. */}
        <p class="eyebrow" lang={site.locale}>Engineering</p>
        <h1 class="article-header__title" id="article-title">{article.title}</h1>
        <p class="article-header__meta">
          {/* Dates render in the site language, so the element says so. */}
          <time datetime={article.pubDate} lang={site.locale}>
            {dateFormatter.format(new Date(article.pubDate))}
          </time>
          <span aria-hidden="true">·</span>
          <a class="article-header__author" href={about.route}>{site.identity.displayName}</a>
        </p>
        <ul class="article-header__tags" aria-label="Topics">
          {article.tags.map((tag) => (
            <li class="chip">{tag}</li>
          ))}
        </ul>
      </header>

      <div class="eng-body" data-reveal>
        <Content />
      </div>

      <nav class="article-nav" aria-label="Back to Engineering" lang={site.locale}>
        <a href="/engineering">&larr; Back to Engineering</a>
        {article.relatedProject && (
          <a href={article.relatedProject}>Project: {article.relatedProjectName}</a>
        )}
      </nav>
    </div>
  </article>
</BaseLayout>

<style>
  .article-header {
    display: grid;
    gap: var(--space-3);
    justify-items: start;
  }

  .article-header__title {
    font-size: var(--text-2xl);
  }

  .article-header__meta {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }

  /* Authorship: visible link to the author's /about page. */
  .article-header__author {
    color: var(--color-text-secondary);
    border-block-end: 1px solid var(--color-border);
    transition:
      color var(--duration-base) var(--ease-out),
      border-color var(--duration-base) var(--ease-out);
  }

  .article-header__author:hover {
    color: var(--color-text);
    border-block-end-color: var(--color-text);
  }

  .article-header__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .article-nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5);
    padding-block-start: var(--space-7);
    font-size: var(--text-sm);
  }

  /* Minimal article typography, mirroring the tokens used elsewhere. */
  .eng-body {
    max-width: var(--measure);
    padding-block-start: var(--space-6);
  }

  .eng-body :global(h2) {
    font-size: var(--text-lg);
    padding-block-start: var(--space-5);
  }

  .eng-body :global(p) {
    color: var(--color-text-secondary);
  }
</style>
