---
import { ClientRouter } from 'astro:transitions';
import '@fontsource-variable/inter';
import '@fontsource-variable/space-grotesk';
import Footer from '../components/Footer.astro';
import Navbar from '../components/Navbar.astro';
import Seo from '../components/Seo.astro';
import { site } from '../data/site';
import type { ArticleEntity, ProjectEntity } from '../data/site';
import '../styles/global.css';

interface Props {
  /** Page title without the site name; the homepage uses the site default. */
  title?: string;
  description?: string;
  /** Open Graph type passed through to the SEO component. */
  type?: 'website' | 'article';
  /** Structured-data entity, only for pages that describe a project. */
  project?: ProjectEntity;
  /** Structured-data facts for an engineering article page. */
  article?: ArticleEntity;
  /** Marks the page as a schema.org ProfilePage, only for /about. */
  profilePage?: boolean;
  /**
   * Language of this page's main content. Defaults to the site language; a page
   * whose body is written in another language (e.g. an article in Spanish)
   * passes its own, so `<html lang>` describes the content rather than the UI.
   */
  lang?: string;
}

const { title, description, type, project, article, profilePage, lang = site.locale } =
  Astro.props;

/**
 * Language of the shared chrome (skip link, navbar, footer). Marked explicitly
 * only when it differs from the page content, so a page in another language
 * still describes its English UI correctly.
 */
const chromeLang = lang === site.locale ? undefined : site.locale;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <Seo
      title={title}
      description={description}
      type={type}
      project={project}
      article={article}
      profilePage={profilePage}
    />
    <ClientRouter />
    <script is:inline>
      // Progressive enhancement flag: reveal animations only hide content when
      // JavaScript is available. The watchdog below keeps the page readable if
      // the animation module ever fails to load.
      document.documentElement.classList.add('has-js');
      window.setTimeout(function () {
        if (!document.documentElement.classList.contains('reveal-ready')) {
          document.documentElement.classList.add('reveal-fallback');
        }
      }, 1500);
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main" lang={chromeLang}>Skip to content</a>
    <Navbar lang={chromeLang} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer lang={chromeLang} />
    <script>
      import '../scripts/ui';
    </script>
  </body>
</html>